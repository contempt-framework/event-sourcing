{
    "name": "contempt/event-sourcing",
    "description": "Event store, aggregate stream and optimistic-concurrency integration.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/contempt-framework/event-sourcing",
    "require": {
        "contempt/compiler": "self.version",
        "contempt/contracts": "self.version",
        "contempt/core": "self.version",
        "contempt/database": "self.version",
        "contempt/messaging": "self.version",
        "contempt/serializer": "self.version",
        "contempt/transaction": "self.version",
        "php": "^8.5",
        "psr/clock": "^1.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Contempt\\EventSourcing\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Contempt\\EventSourcing\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=1G --no-progress",
        "test": "phpunit",
        "qa": [
            "@analyse",
            "@test"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
